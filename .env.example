# Port the container/app listens on (host side in docker-compose)
PORT=8080
# SQLite database location. In Docker this must live on the /data volume.
DATABASE_PATH=/data/bindarr.db
# App version baked into /api/health (compose build-arg + runtime env).
APP_VERSION=0.1.0
# GitHub repo for Settings “update available” checks (owner/name).
GITHUB_REPO=anmokhta/bindarr
# Pokémon lookups use the free TCGdex API (https://tcgdex.dev/) — no API key required.
