{
  "name": "@bindarr/desktop-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Bindarr desktop app (Electron shell around the local Bindarr server)",
  "author": {
    "name": "anmokhta",
    "email": "anmokhta@users.noreply.github.com"
  },
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/anmokhta/bindarr.git"
  },
  "scripts": {
    "start": "electron .",
    "prepare-backend": "node scripts/prepare-backend.mjs",
    "dist": "node scripts/prepare-backend.mjs && electron-builder --publish never",
    "dist:dir": "node scripts/prepare-backend.mjs && electron-builder --dir --publish never",
    "dist:publish": "node scripts/prepare-backend.mjs && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bindarr.app",
    "productName": "Bindarr",
    "executableName": "bindarr",
    "files": [
      "**/*",
      "!scripts",
      "!scripts/**",
      "!.backend",
      "!.backend/**",
      "!dist",
      "!dist/**"
    ],
    "extraResources": [{ "from": ".backend", "to": "backend", "filter": ["**/*"] }],
    "publish": [
      {
        "provider": "github",
        "owner": "anmokhta",
        "repo": "bindarr"
      }
    ],
    "mac": { "category": "public.app-category-productivity", "target": ["dmg"] },
    "win": { "target": ["nsis"] },
    "linux": { "category": "Utility", "target": ["AppImage", "deb"] },
    "deb": { "packageName": "bindarr" }
  }
}
